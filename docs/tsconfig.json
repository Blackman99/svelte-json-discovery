{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "moduleDetection": "force",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "resolveJsonModule": true,
        "types": [
            "svelte",
            "vite/client"
        ],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.svelte",
        "vite.config.ts"
    ]
}
