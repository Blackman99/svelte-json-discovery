{
    "name": "svelte-json-discovery",
    "type": "module",
    "version": "0.3.0",
    "description": "Standalone Svelte 5 port of the struct (JSON) view from discoveryjs/discovery",
    "license": "MIT",
    "homepage": "https://blackman99.github.io/svelte-json-discovery/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Blackman99/svelte-json-discovery.git",
        "directory": "packages/svelte-json-discovery"
    },
    "bugs": "https://github.com/Blackman99/svelte-json-discovery/issues",
    "keywords": [
        "svelte",
        "json",
        "viewer",
        "json-viewer",
        "discoveryjs",
        "struct"
    ],
    "svelte": "./dist/index.js",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./inspector": {
            "types": "./dist/inspector/index.d.ts",
            "svelte": "./dist/inspector/index.js",
            "default": "./dist/inspector/index.js"
        },
        "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "!dist/**/*.map",
        "dist"
    ],
    "scripts": {
        "build": "svelte-package -i src -o dist",
        "dev": "svelte-package -i src -o dist -w",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/package": "^2.5.8",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.6",
        "@tsconfig/svelte": "^5.0.8",
        "jsdom": "^30.0.1",
        "svelte": "^5.56.9",
        "svelte-check": "^4.7.3",
        "typescript": "~6.0.3",
        "vitest": "^4.1.11"
    },
    "publishConfig": {
        "access": "public"
    }
}
