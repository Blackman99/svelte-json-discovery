{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "moduleDetection": "force",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "resolveJsonModule": true,
        "types": [
            "svelte",
            "node"
        ],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "isolatedModules": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.svelte",
        "src/**/*.d.ts"
    ]
}
